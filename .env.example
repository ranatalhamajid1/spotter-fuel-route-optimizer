# Django Core Configuration
DEBUG=True
SECRET_KEY=change-this-in-production-django-insecure-key-12345
ALLOWED_HOSTS=*

# Database Configuration (Optional: defaults to SQLite db.sqlite3 if omitted)
# DATABASE_URL=postgres://user:password@localhost:5432/spotter_fuel

# Routing Provider (Default is 'osrm' which requires NO API key)
ROUTING_PROVIDER=osrm
OSRM_SERVER_URL=https://router.project-osrm.org

# Optional: OpenRouteService API Key (if switching ROUTING_PROVIDER=ors)
ROUTING_API_KEY=

# Geocoding Provider & Settings ('photon' or 'nominatim')
GEOCODING_PROVIDER=photon
GEOCODING_USER_AGENT=SpotterFuelRouteOptimizer/1.0

# Vehicle & Route Constraints
VEHICLE_MAX_RANGE_MILES=500.0
VEHICLE_MPG=10.0
CORRIDOR_SEARCH_RADIUS_MILES=10.0
